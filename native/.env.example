# Function domain, without /v1; HTTPS required.
PARTY_FUNCTION_URL=https://your-function-domain.appwrite.run
PARTY_APPWRITE_ENDPOINT=https://your-region.cloud.appwrite.io/v1
PARTY_PROJECT_ID=your-project
PARTY_DATABASE_ID=party-v2
# Choose an existing user's session secret (automatic JWT refresh + Realtime)
# or a JWT/file refreshed by your existing login integration.
PARTY_SESSION_SECRET=
PARTY_JWT_FILE=
# Optional STUN plus up to two UDP TURN servers. Supply short-lived TURN credentials at runtime.
PARTY_ICE_SERVERS=[{"url":"stun:your-stun.example:3478"},{"url":"turn:your-turn.example:3478","username":"runtime-user","credential":"runtime-secret"}]
PARTY_RELAY_ONLY=0

# Optional private certificate authority PEM; normal system TLS trust stays enabled.
# PARTY_CA_BUNDLE=/path/to/private-ca.pem
# Optional interface binding for diagnostics; leave unset on real Internet tests.
# PARTY_BIND_ADDRESS=127.0.0.1
