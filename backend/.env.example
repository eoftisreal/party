APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<project-id>
PARTY_DATABASE_ID=party-v2
PARTY_ROOMS_COLLECTION_ID=rooms
PARTY_MEMBERS_COLLECTION_ID=members
# PARTY_APPWRITE_API_KEY=server-only-key
PARTY_PEERS_COLLECTION_ID=peers
PARTY_SIGNALS_COLLECTION_ID=signals
PARTY_NOTIFICATIONS_COLLECTION_ID=notifications
PARTY_LIMITS_COLLECTION_ID=limits
# Development default: 0 disables the per-user room-creation cap. Set to 4 (or another positive integer) for production.
PARTY_CREATE_LIMIT_PER_HOUR=0
# Setup only, never deployed or distributed to clients:
# PARTY_SETUP_API_KEY=short-lived-schema-key

# Configure centrally; players fetch these after joining (no local ICE JSON required).
# Default: public STUN discovery (stun:stun.cloudflare.com:3478), no TURN relay.
# STUN sends address-discovery packets only; movie traffic remains peer-to-peer.
# Set PARTY_STUN_URLS=[] to disable public discovery, or supply your own server.
# UDP only with bundled libjuice: at most 1 STUN and 2 TURN URLs.
# PARTY_STUN_URLS=["stun:turn.example.com:3478"]
# PARTY_TURN_URLS=["turn:turn.example.com:3478?transport=udp"]
# Server-only secret, at least 32 characters; must match coturn static-auth-secret.
# PARTY_TURN_SECRET=<random-secret>
# PARTY_TURN_TTL_SECONDS=3600
